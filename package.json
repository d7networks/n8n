{
  "name": "n8n-nodes-direct7",
  "version": "1.0.2",
  "description": "n8n nodes for Direct7 messaging integration.",
  "license": "MIT",
  "homepage": "https://d7networks.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d7networks/n8n.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "direct7",
    "whatsapp",
    "messaging",
    "d7networks"
  ],
  "author": {
    "name": "Midhun K",
    "email": "midhun@signtaper.com"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/Direct7Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Direct7/Direct7.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
